{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "suika-sharing",
  "main": "worker.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "GAMES", "id": "YOUR_KV_NAMESPACE_ID" },
  ],
  "vars": { "ALLOWED_ORIGIN": "https://letianhu18-web.github.io" },
  "ratelimits": [
    {
      "name": "CREATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "GLOBAL_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
}
